<UserControl x:Class="DesktopCommandCenter.App.Controls.QuickActionTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Button Height="50"
            IsEnabled="{Binding IsActionEnabled, ElementName=Root}"
            Command="{Binding Command, ElementName=Root}"
            HorizontalContentAlignment="Left"
            Padding="8,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Icon, ElementName=Root}"
                       FontSize="13"
                       FontFamily="Segoe UI Symbol"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Label, ElementName=Root}"
                       FontSize="10.5"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Button>
</UserControl>
