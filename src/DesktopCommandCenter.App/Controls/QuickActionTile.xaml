<UserControl x:Class="DesktopCommandCenter.App.Controls.QuickActionTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Button Height="66" IsEnabled="{Binding IsActionEnabled, ElementName=Root}"
            HorizontalContentAlignment="Left" Padding="10">
        <StackPanel>
            <TextBlock Text="{Binding Icon, ElementName=Root}" FontSize="17"
                       FontFamily="Segoe UI Symbol" Margin="0,0,0,5" />
            <TextBlock Text="{Binding Label, ElementName=Root}" FontSize="11.5" />
        </StackPanel>
    </Button>
</UserControl>