<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>DesktopCommandCenter</AssemblyName>
    <RootNamespace>DesktopCommandCenter.App</RootNamespace>
    <Version>0.2.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DesktopCommandCenter.Core\DesktopCommandCenter.Core.csproj" />
    <ProjectReference Include="..\DesktopCommandCenter.Windows\DesktopCommandCenter.Windows.csproj" />
  </ItemGroup>
</Project>
