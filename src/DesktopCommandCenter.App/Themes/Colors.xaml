<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#00101418</Color>
    <Color x:Key="PanelBackgroundColor">#F2181C22</Color>
    <Color x:Key="NavigationBackgroundColor">#E512151A</Color>
    <Color x:Key="CardBackgroundColor">#FF22272F</Color>
    <Color x:Key="CardHoverBackgroundColor">#FF2A3039</Color>
    <Color x:Key="BorderSubtleColor">#FF343A44</Color>
    <Color x:Key="TextPrimaryColor">#FFF1F4F8</Color>
    <Color x:Key="TextSecondaryColor">#FFB6BEC9</Color>
    <Color x:Key="TextMutedColor">#FF7F8996</Color>
    <Color x:Key="AccentColor">#FF4C8DFF</Color>
    <Color x:Key="AccentHoverColor">#FF68A0FF</Color>
    <Color x:Key="AccentSoftColor">#334C8DFF</Color>
    <Color x:Key="DangerColor">#FFFF6B72</Color>
    <Color x:Key="SuccessColor">#FF57C785</Color>

    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="NavigationBackground" Color="{StaticResource NavigationBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardHoverBackground" Color="{StaticResource CardHoverBackgroundColor}" />
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
</ResourceDictionary>