<Window x:Class="DesktopCommandCenter.App.Views.AmbienceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Grid x:Name="SceneRoot"
          Background="Transparent"
          IsHitTestVisible="False"
          ClipToBounds="True">
        <Canvas x:Name="BackgroundLayer"
                Background="Transparent"
                IsHitTestVisible="False"
                ClipToBounds="True" />
        <Canvas x:Name="CreatureLayer"
                Background="Transparent"
                IsHitTestVisible="False"
                ClipToBounds="True" />
        <Canvas x:Name="EffectLayer"
                Background="Transparent"
                IsHitTestVisible="False"
                ClipToBounds="True" />
    </Grid>
</Window>
