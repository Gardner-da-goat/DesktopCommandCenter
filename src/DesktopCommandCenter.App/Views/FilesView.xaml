<UserControl x:Class="DesktopCommandCenter.App.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Content="←"
                    Command="{Binding BackCommand}"
                    Width="36"
                    Height="34"
                    Margin="0,0,6,0"
                    ToolTip="Back" />
            <Button Grid.Column="1"
                    Content="↑"
                    Command="{Binding UpCommand}"
                    Width="36"
                    Height="34"
                    Margin="0,0,8,0"
                    ToolTip="Up" />
            <Border Grid.Column="2"
                    Height="34"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,0">
                <TextBlock Text="{Binding CurrentPath}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Border>
            <Button Grid.Column="3"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Margin="8,0,6,0"
                    Padding="12,5" />
            <Button Grid.Column="4"
                    Content="Open in Explorer"
                    Command="{Binding OpenInExplorerCommand}"
                    Padding="12,5" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Locations"
                               FontWeight="SemiBold"
                               Margin="6,4,6,8" />
                    <ItemsControl ItemsSource="{Binding QuickLocations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Tag="{Binding}"
                                        Click="OnQuickLocationClick"
                                        HorizontalContentAlignment="Left"
                                        Padding="9,6"
                                        Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>

                    <ListView x:Name="FilesList"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              MouseDoubleClick="OnFilesDoubleClick"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="360" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding Type}" />
                                <GridViewColumn Header="Size" Width="95" DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="Modified" Width="145" DisplayMemberBinding="{Binding Modified}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,0,0"
                            Padding="10,0">
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
