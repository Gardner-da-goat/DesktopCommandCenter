<UserControl x:Class="DesktopCommandCenter.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modules="clr-namespace:DesktopCommandCenter.App.Views.Modules">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="14,14,14,22">
            <TextBlock Text="Home" Style="{StaticResource PageTitleText}" Margin="2,0,0,14" />

            <Grid Height="44">
                <TextBox Style="{StaticResource ModernTextBox}"
                         Tag="Search apps, windows, commands..."
                         Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="⌕"
                           FontFamily="Segoe UI Symbol"
                           FontSize="20"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="13,0,0,1"
                           IsHitTestVisible="False" />
            </Grid>

            <Border Style="{StaticResource CardStyle}"
                    Margin="0,8,0,18"
                    Padding="6"
                    Visibility="{Binding Search.HasQuery, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Search.Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding ExecuteCommand}"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        Padding="8,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}"
                                                   FontFamily="Segoe UI Symbol"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource AccentHover}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No matching apps, windows, or actions."
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               Margin="8,10"
                               Visibility="{Binding Search.HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <modules:FavoritesModule Margin="0,0,0,16" />
            <modules:CurrentWindowModule Margin="0,0,0,16" />
            <modules:QuickActionsModule Margin="0,0,0,16" />
            <modules:MacrosModule />
        </StackPanel>
    </ScrollViewer>
</UserControl>
