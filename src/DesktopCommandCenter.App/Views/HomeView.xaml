<UserControl x:Class="DesktopCommandCenter.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modules="clr-namespace:DesktopCommandCenter.App.Views.Modules">
    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="10,10,10,14">
            <TextBlock Text="Home"
                       Style="{StaticResource PageTitleText}"
                       Margin="2,0,0,9" />

            <StackPanel Visibility="{Binding ShowSearchModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Height="38">
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Tag="Search apps, windows, commands..."
                             Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="⌕"
                               FontFamily="Segoe UI Symbol"
                               FontSize="17"
                               Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               IsHitTestVisible="False" />
                </Grid>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,6,0,10"
                        Padding="5"
                        Visibility="{Binding Search.HasQuery, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Search.Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding ExecuteCommand}"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                Padding="6,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontFamily="Segoe UI Symbol"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource AccentHover}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="9.5"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Content="{Binding SecondaryLabel}"
                                                Command="{Binding SecondaryCommand}"
                                                Padding="6,4"
                                                Margin="3,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasSecondaryAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No matches."
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   Margin="6"
                                   Visibility="{Binding Search.HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <modules:FavoritesModule Margin="0,0,0,10"
                                     Visibility="{Binding ShowFavoritesModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <modules:RecentModule Margin="0,0,0,10"
                                  Visibility="{Binding ShowRecentModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <modules:CurrentWindowModule Margin="0,0,0,10"
                                         Visibility="{Binding ShowCurrentWindowModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <modules:QuickActionsModule Margin="0,0,0,10"
                                        Visibility="{Binding ShowQuickActionsModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <modules:MacrosModule Margin="0,0,0,10"
                                  Visibility="{Binding ShowMacrosModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <modules:ClipboardModule Margin="0,0,0,10"
                                      Visibility="{Binding ShowClipboardModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <modules:MediaModule Visibility="{Binding ShowMediaModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
