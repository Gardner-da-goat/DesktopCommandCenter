<UserControl x:Class="DesktopCommandCenter.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modules="clr-namespace:DesktopCommandCenter.App.Views.Modules">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="14,14,14,22">
            <TextBlock Text="Home" Style="{StaticResource PageTitleText}" Margin="2,0,0,14" />

            <Grid Height="44" Margin="0,0,0,18">
                <TextBox Style="{StaticResource ModernTextBox}"
                         Tag="Search apps, windows, commands..." />
                <TextBlock Text="⌕" FontFamily="Segoe UI Symbol" FontSize="20"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="13,0,0,1" IsHitTestVisible="False" />
            </Grid>

            <modules:FavoritesModule Margin="0,0,0,16" />
            <modules:CurrentWindowModule Margin="0,0,0,16" />
            <modules:QuickActionsModule Margin="0,0,0,16" />
            <modules:MacrosModule />
        </StackPanel>
    </ScrollViewer>
</UserControl>