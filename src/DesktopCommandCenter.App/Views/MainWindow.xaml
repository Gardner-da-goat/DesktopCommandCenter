<Window x:Class="DesktopCommandCenter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Command Center"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource NavigationBackground}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="4,8,4,16">
                    <Border Width="38"
                            Height="38"
                            CornerRadius="11"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Accent}">
                        <TextBlock Text="⌘"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Desktop Hub"
                               Style="{StaticResource AppTitleText}"
                               FontSize="19"
                               Margin="0,10,0,2" />
                    <TextBlock Text="Everything in one place"
                               Style="{StaticResource MutedText}" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton GroupName="HubNavigation"
                                 Content="⌂   Home"
                                 Style="{StaticResource NavigationButton}"
                                 Height="42"
                                 HorizontalContentAlignment="Left"
                                 Padding="12,0"
                                 Margin="0,2"
                                 IsChecked="{Binding IsHomeSelected}"
                                 Command="{Binding ShowHomeCommand}" />
                    <RadioButton GroupName="HubNavigation"
                                 Content="♪   Music"
                                 Style="{StaticResource NavigationButton}"
                                 Height="42"
                                 HorizontalContentAlignment="Left"
                                 Padding="12,0"
                                 Margin="0,2"
                                 IsChecked="{Binding IsMusicSelected}"
                                 Command="{Binding ShowMusicCommand}" />
                    <RadioButton GroupName="HubNavigation"
                                 Content="▰   Files"
                                 Style="{StaticResource NavigationButton}"
                                 Height="42"
                                 HorizontalContentAlignment="Left"
                                 Padding="12,0"
                                 Margin="0,2"
                                 IsChecked="{Binding IsFilesSelected}"
                                 Command="{Binding ShowFilesCommand}" />
                    <RadioButton GroupName="HubNavigation"
                                 Content="▣   Windows"
                                 Style="{StaticResource NavigationButton}"
                                 Height="42"
                                 HorizontalContentAlignment="Left"
                                 Padding="12,0"
                                 Margin="0,2"
                                 IsChecked="{Binding IsWindowsSelected}"
                                 Command="{Binding ShowWindowsCommand}" />
                    <RadioButton GroupName="HubNavigation"
                                 Content="✦   Ambience"
                                 Style="{StaticResource NavigationButton}"
                                 Height="42"
                                 HorizontalContentAlignment="Left"
                                 Padding="12,0"
                                 Margin="0,2"
                                 IsChecked="{Binding IsAmbienceSelected}"
                                 Command="{Binding ShowAmbienceCommand}" />
                    <RadioButton GroupName="HubNavigation"
                                 Content="⚙   Settings"
                                 Style="{StaticResource NavigationButton}"
                                 Height="42"
                                 HorizontalContentAlignment="Left"
                                 Padding="12,0"
                                 Margin="0,2"
                                 IsChecked="{Binding IsSettingsSelected}"
                                 Command="{Binding ShowSettingsCommand}" />
                </StackPanel>

                <Border Grid.Row="2"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Quick sidebar"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="The edge sidebar stays available as a fast controller while this hub handles the full app."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource PanelBackground}">
                <Grid Margin="18,0">
                    <TextBlock Text="{Binding CurrentSection}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="4"
                            ClipToBounds="True" />
        </Grid>
    </Grid>
</Window>
