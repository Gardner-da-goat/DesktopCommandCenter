<Window x:Class="DesktopCommandCenter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Command Center"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="HubNavigationButton" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="9"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource CardHoverBackground}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoft}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource NavigationBackground}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="4,8,4,16">
                    <Border Width="38"
                            Height="38"
                            CornerRadius="11"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Accent}">
                        <TextBlock Text="⌘"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Desktop Hub"
                               Style="{StaticResource AppTitleText}"
                               FontSize="19"
                               Margin="0,10,0,2" />
                    <TextBlock Text="Everything in one place"
                               Style="{StaticResource MutedText}" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton GroupName="HubNavigation"
                                 Content="⌂   Home"
                                 Style="{StaticResource HubNavigationButton}"
                                 IsChecked="{Binding IsHomeSelected}"
                                 Command="{Binding ShowHomeCommand}" />
                    <RadioButton GroupName="HubNavigation"
                                 Content="♪   Music"
                                 Style="{StaticResource HubNavigationButton}"
                                 IsChecked="{Binding IsMusicSelected}"
                                 Command="{Binding ShowMusicCommand}" />
                    <RadioButton GroupName="HubNavigation"
                                 Content="▰   Files"
                                 Style="{StaticResource HubNavigationButton}"
                                 IsChecked="{Binding IsFilesSelected}"
                                 Command="{Binding ShowFilesCommand}" />
                    <RadioButton GroupName="HubNavigation"
                                 Content="▣   Windows"
                                 Style="{StaticResource HubNavigationButton}"
                                 IsChecked="{Binding IsWindowsSelected}"
                                 Command="{Binding ShowWindowsCommand}" />
                    <RadioButton GroupName="HubNavigation"
                                 Content="✦   Ambience"
                                 Style="{StaticResource HubNavigationButton}"
                                 IsChecked="{Binding IsAmbienceSelected}"
                                 Command="{Binding ShowAmbienceCommand}" />
                    <RadioButton GroupName="HubNavigation"
                                 Content="⚙   Settings"
                                 Style="{StaticResource HubNavigationButton}"
                                 IsChecked="{Binding IsSettingsSelected}"
                                 Command="{Binding ShowSettingsCommand}" />
                </StackPanel>

                <Border Grid.Row="2"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Quick sidebar"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="The edge sidebar stays available as a fast controller while this hub handles the full app."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource PanelBackground}">
                <Grid Margin="18,0">
                    <TextBlock Text="{Binding CurrentSection}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="4"
                            ClipToBounds="True" />
        </Grid>
    </Grid>
</Window>
