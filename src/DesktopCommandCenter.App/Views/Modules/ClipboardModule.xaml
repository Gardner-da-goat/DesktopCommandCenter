<UserControl x:Class="DesktopCommandCenter.App.Views.Modules.ClipboardModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}" Padding="10">
        <StackPanel>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Clipboard"
                           Style="{StaticResource SectionTitleText}" />
                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding Clipboard.RefreshCommand}"
                        Padding="7,3" />
            </Grid>

            <Border Background="{DynamicResource CardHoverBackground}"
                    CornerRadius="7"
                    Padding="8"
                    Margin="0,0,0,6">
                <TextBlock Text="{Binding Clipboard.Preview}"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap"
                           MaxHeight="54"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <UniformGrid Columns="2" Margin="0,0,0,4">
                <Button Content="History"
                        Command="{Binding Clipboard.OpenHistoryCommand}"
                        Margin="0,0,3,0"
                        Padding="6,5" />
                <Button Content="Clear"
                        Command="{Binding Clipboard.ClearCommand}"
                        Margin="3,0,0,0"
                        Padding="6,5" />
            </UniformGrid>

            <TextBlock Text="{Binding Clipboard.Status}"
                       Style="{StaticResource MutedText}"
                       FontSize="9.5" />
        </StackPanel>
    </Border>
</UserControl>
