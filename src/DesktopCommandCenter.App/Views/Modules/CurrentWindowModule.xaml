<UserControl x:Class="DesktopCommandCenter.App.Views.Modules.CurrentWindowModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Current Window" Style="{StaticResource SectionTitleText}" />
            <TextBlock Text="Google Chrome" Margin="0,9,0,2" />
            <TextBlock Text="Window controls coming soon" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Opacity" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="100%" Style="{StaticResource MutedText}" DockPanel.Dock="Right" />
            </DockPanel>
            <Slider Style="{StaticResource ModernSlider}" Minimum="10" Maximum="100" Value="100" IsEnabled="False" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button Content="Minimize" IsEnabled="False" />
                <Button Grid.Column="2" Content="Maximize" IsEnabled="False" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>