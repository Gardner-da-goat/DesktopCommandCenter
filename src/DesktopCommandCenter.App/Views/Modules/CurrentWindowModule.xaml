<UserControl x:Class="DesktopCommandCenter.App.Views.Modules.CurrentWindowModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Current Window" Style="{StaticResource SectionTitleText}" />

            <TextBlock Text="{Binding CurrentWindow.Title, TargetNullValue=No active application window}"
                       Margin="0,9,0,2"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding CurrentWindow.ProcessName, TargetNullValue=Switch to another app to control it here.}"
                       Style="{StaticResource MutedText}"
                       Margin="0,0,0,12" />

            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Opacity" Style="{StaticResource SecondaryText}" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}">
                    <Run Text="{Binding CurrentWindow.Opacity, TargetNullValue=100}" />
                    <Run Text="%" />
                </TextBlock>
            </DockPanel>
            <Slider Style="{StaticResource ModernSlider}"
                    Minimum="20"
                    Maximum="100"
                    Value="{Binding CurrentWindow.Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding HasCurrentWindow}" />

            <Grid Margin="0,9,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Always on top" />
                    <TextBlock Text="Pin this app above normal windows." Style="{StaticResource MutedText}" />
                </StackPanel>
                <CheckBox Grid.Column="1"
                          Style="{StaticResource ToggleSwitchStyle}"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding HasCurrentWindow}"
                          IsChecked="{Binding CurrentWindow.IsAlwaysOnTop, Mode=TwoWay}" />
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Content="Minimize"
                        Command="{Binding CurrentWindow.MinimizeCommand}"
                        IsEnabled="{Binding HasCurrentWindow}" />
                <Button Grid.Column="2"
                        Content="Maximize"
                        Command="{Binding CurrentWindow.MaximizeCommand}"
                        IsEnabled="{Binding HasCurrentWindow}" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Content="Snap Left"
                        Command="{Binding CurrentWindow.SnapLeftCommand}"
                        IsEnabled="{Binding HasCurrentWindow}" />
                <Button Grid.Column="2"
                        Content="Snap Right"
                        Command="{Binding CurrentWindow.SnapRightCommand}"
                        IsEnabled="{Binding HasCurrentWindow}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
