<UserControl x:Class="DesktopCommandCenter.App.Views.Modules.MacrosModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Macros" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="4" Height="24" Background="{DynamicResource Accent}" CornerRadius="2" />
                <TextBlock Grid.Column="1" Text="Work Mode" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Coming soon" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="4" Height="24" Background="{DynamicResource Success}" CornerRadius="2" />
                <TextBlock Grid.Column="1" Text="Gaming Mode" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Coming soon" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </Grid>
            <Button Content="＋  Create Macro" HorizontalAlignment="Stretch" IsEnabled="False" />
        </StackPanel>
    </Border>
</UserControl>