<UserControl x:Class="DesktopCommandCenter.App.Views.Modules.QuickActionsModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopCommandCenter.App.Controls">
    <StackPanel>
        <TextBlock Text="Quick Actions"
                   Style="{StaticResource SectionTitleText}"
                   Margin="2,0,0,6" />
        <UniformGrid Columns="2">
            <controls:QuickActionTile Icon="⇩" Label="Downloads"
                                      Command="{Binding OpenDownloadsCommand}"
                                      Visibility="{Binding ShowDownloadsAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="0,0,3,3" />
            <controls:QuickActionTile Icon="▤" Label="Task Manager"
                                      Command="{Binding OpenTaskManagerCommand}"
                                      Visibility="{Binding ShowTaskManagerAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="3,0,0,3" />
            <controls:QuickActionTile Icon="⚙" Label="Settings"
                                      Command="{Binding OpenSettingsCommand}"
                                      Visibility="{Binding ShowWindowsSettingsAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="0,3,3,3" />
            <controls:QuickActionTile Icon="⌨" Label="Terminal"
                                      Command="{Binding OpenTerminalCommand}"
                                      Visibility="{Binding ShowTerminalAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="3,3,0,3" />
            <controls:QuickActionTile Icon="▧" Label="Screenshot"
                                      Command="{Binding OpenScreenshotCommand}"
                                      Visibility="{Binding ShowScreenshotAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="0,3,3,0" />
            <controls:QuickActionTile Icon="♪" Label="Mute"
                                      Command="{Binding ToggleMuteCommand}"
                                      Visibility="{Binding ShowMuteAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="3,3,0,3" />
            <controls:QuickActionTile Icon="+" Label="Volume Up"
                                      Command="{Binding VolumeUpCommand}"
                                      Visibility="{Binding ShowVolumeUpAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="0,3,3,3" />
            <controls:QuickActionTile Icon="−" Label="Volume Down"
                                      Command="{Binding VolumeDownCommand}"
                                      Visibility="{Binding ShowVolumeDownAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="3,3,0,3" />
            <controls:QuickActionTile Icon="▣" Label="Clipboard"
                                      Command="{Binding OpenClipboardCommand}"
                                      Visibility="{Binding ShowClipboardAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="0,3,3,0" />
            <controls:QuickActionTile Icon="▶" Label="Play / Pause"
                                      Command="{Binding PlayPauseCommand}"
                                      Visibility="{Binding ShowPlayPauseAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="3,3,0,0" />
        </UniformGrid>
    </StackPanel>
</UserControl>
