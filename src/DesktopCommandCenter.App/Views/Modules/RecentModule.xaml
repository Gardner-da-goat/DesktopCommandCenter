<UserControl x:Class="DesktopCommandCenter.App.Views.Modules.RecentModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}" Padding="10">
        <StackPanel>
            <TextBlock Text="Recent"
                       Style="{StaticResource SectionTitleText}"
                       Margin="0,0,0,6" />

            <ItemsControl ItemsSource="{Binding Recent.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding RunCommand}"
                                Background="Transparent"
                                HorizontalContentAlignment="Stretch"
                                Padding="4,5"
                                Margin="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="10.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="9"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TimeText}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Your recent actions will appear here."
                       Margin="0,1,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Recent.HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
