<UserControl x:Class="DesktopCommandCenter.App.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Music"
                               FontSize="30"
                               FontWeight="SemiBold" />
                    <TextBlock Text="PulseDeck is becoming the music part of this hub. The hub reads your existing PulseDeck library and keeps Windows media controls available in the same place."
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Command="{Binding RefreshLibraryCommand}"
                            Padding="12,7"
                            Margin="0,0,6,0" />
                    <Button Content="Open PulseDeck"
                            Command="{Binding OpenPulseDeckCommand}"
                            Padding="14,7" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardStyle}"
                    Padding="16"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding LibraryStatus}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <UniformGrid Columns="3">
                        <Border Background="{DynamicResource CardHoverBackground}"
                                CornerRadius="9"
                                Padding="12"
                                Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="{Binding TrackCount}"
                                           FontSize="24"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Tracks"
                                           Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardHoverBackground}"
                                CornerRadius="9"
                                Padding="12"
                                Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="{Binding PlaylistCount}"
                                           FontSize="24"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Playlists"
                                           Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardHoverBackground}"
                                CornerRadius="9"
                                Padding="12"
                                Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding FavoriteCount}"
                                           FontSize="24"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Favorites"
                                           Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}"
                        Padding="18"
                        Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="Media controls"
                                   Style="{StaticResource SectionTitleText}"
                                   FontSize="18"
                                   Margin="0,0,0,12" />

                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <Button Content="Previous"
                                    Command="{Binding PreviousTrackCommand}"
                                    Height="46"
                                    Margin="0,0,5,0" />
                            <Button Content="Play / Pause"
                                    Command="{Binding PlayPauseCommand}"
                                    Height="46"
                                    Margin="5,0" />
                            <Button Content="Next"
                                    Command="{Binding NextTrackCommand}"
                                    Height="46"
                                    Margin="5,0,0,0" />
                        </UniformGrid>

                        <UniformGrid Columns="3">
                            <Button Content="Volume −"
                                    Command="{Binding VolumeDownCommand}"
                                    Height="38"
                                    Margin="0,0,5,0" />
                            <Button Content="Mute"
                                    Command="{Binding ToggleMuteCommand}"
                                    Height="38"
                                    Margin="5,0" />
                            <Button Content="Volume +"
                                    Command="{Binding VolumeUpCommand}"
                                    Height="38"
                                    Margin="5,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        Padding="18"
                        Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Library shortcuts"
                                   Style="{StaticResource SectionTitleText}"
                                   FontSize="18"
                                   Margin="0,0,0,10" />
                        <Button Content="Open Music Folder"
                                Command="{Binding OpenMusicFolderCommand}"
                                Padding="12,7"
                                Margin="0,0,0,7" />
                        <Button Content="Open PulseDeck Data"
                                Command="{Binding OpenPulseDeckDataCommand}"
                                Padding="12,7" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}"
                    Padding="16"
                    Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Recently played"
                               Style="{StaticResource SectionTitleText}"
                               FontSize="18"
                               Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding RecentTracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Artist}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Album}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PlayCount, StringFormat={}Played {0}×}"
                                               Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Recent tracks come directly from PulseDeck's existing local library data. The original music files are not modified."
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
