<UserControl x:Class="DesktopCommandCenter.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CompactCategoryItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactStartOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome"
                                Padding="8,5"
                                Background="{DynamicResource CardHoverBackground}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GeneralTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <RadioButton Content="Collapsed"
                                 GroupName="StartState"
                                 Style="{StaticResource CompactStartOption}"
                                 IsChecked="{Binding DataContext.StartCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                    <RadioButton Grid.Column="2"
                                 Content="Expanded"
                                 GroupName="StartState"
                                 Style="{StaticResource CompactStartOption}"
                                 IsChecked="{Binding DataContext.StartCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}" />
                </Grid>

                <TextBlock Text="Screen side"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,0,0,4" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <RadioButton Content="Left"
                                 GroupName="SidebarSide"
                                 Style="{StaticResource CompactStartOption}"
                                 IsChecked="{Binding DataContext.IsSidebarOnLeft, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                    <RadioButton Grid.Column="2"
                                 Content="Right"
                                 GroupName="SidebarSide"
                                 Style="{StaticResource CompactStartOption}"
                                 IsChecked="{Binding DataContext.IsSidebarOnRight, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <TextBlock Text="Handle position"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,0,0,4" />
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <RadioButton Content="Top"
                                 GroupName="HandlePosition"
                                 Style="{StaticResource CompactStartOption}"
                                 IsChecked="{Binding DataContext.IsHandleAtTop, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                 Margin="0,0,3,0" />
                    <RadioButton Content="Center"
                                 GroupName="HandlePosition"
                                 Style="{StaticResource CompactStartOption}"
                                 IsChecked="{Binding DataContext.IsHandleAtCenter, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                 Margin="3,0" />
                    <RadioButton Content="Bottom"
                                 GroupName="HandlePosition"
                                 Style="{StaticResource CompactStartOption}"
                                 IsChecked="{Binding DataContext.IsHandleAtBottom, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                 Margin="3,0,0,0" />
                </UniformGrid>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sidebar width"
                               Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="−20"
                            Command="{Binding DataContext.DecreaseSidebarWidthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="7,3"
                            Margin="4,0,4,0" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding DataContext.SidebarWidth, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0}}"
                               VerticalAlignment="Center"
                               MinWidth="30"
                               TextAlignment="Center" />
                    <Button Grid.Column="3"
                            Content="+20"
                            Command="{Binding DataContext.IncreaseSidebarWidthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="7,3"
                            Margin="4,0,0,0" />
                </Grid>
                <Slider Minimum="300"
                        Maximum="520"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        SmallChange="10"
                        LargeChange="20"
                        Style="{StaticResource ModernSlider}"
                        Value="{Binding DataContext.SidebarWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,5" />
                <UniformGrid Columns="4" Margin="0,0,0,8">
                    <Button Content="320"
                            Command="{Binding DataContext.Width320Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,4"
                            Margin="0,0,3,0" />
                    <Button Content="360"
                            Command="{Binding DataContext.Width360Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,4"
                            Margin="3,0" />
                    <Button Content="420"
                            Command="{Binding DataContext.Width420Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,4"
                            Margin="3,0" />
                    <Button Content="480"
                            Command="{Binding DataContext.Width480Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,4"
                            Margin="3,0,0,0" />
                </UniformGrid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Always on top" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.AlwaysOnTop, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Animations" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.AnimationsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Tray icon" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowTrayIcon, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Notifications" />
                        <TextBlock Text="Show update and background task notifications."
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding DataContext.NotificationsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Start with Windows" />
                        <TextBlock Text="Launch at sign-in without administrator access."
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding DataContext.StartWithWindows, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CustomizeHomeTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Search" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowSearchModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Favorites" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowFavoritesModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Current Window" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowCurrentWindowModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Quick Actions" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowQuickActionsModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Macros" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowMacrosModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Media Controls" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowMediaModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Recent Activity" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowRecentModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Clipboard" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowClipboardModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FavoritesTemplate">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding DataContext.Favorites.Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="Remove"
                                        Command="{Binding RemoveCommand}"
                                        Padding="7,4"
                                        Foreground="{DynamicResource Danger}"
                                        Background="Transparent" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Pin apps from Home search results."
                           Style="{StaticResource MutedText}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="QuickActionsTemplate">
            <StackPanel>
                <TextBlock Text="Choose the actions shown on Home."
                           Style="{StaticResource MutedText}"
                           Margin="0,0,0,7" />
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Downloads"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.ShowDownloadsAction, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Task Manager"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.ShowTaskManagerAction, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Windows Settings"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.ShowWindowsSettingsAction, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Terminal"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.ShowTerminalAction, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Screenshot"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.ShowScreenshotAction, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Mute"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.ShowMuteAction, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Volume Up"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.ShowVolumeUpAction, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Volume Down"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.ShowVolumeDownAction, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Clipboard History"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.ShowClipboardAction, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Play / Pause"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.ShowPlayPauseAction, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Show Desktop"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.ShowDesktopAction, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Lock Computer"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.ShowLockAction, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CommandsTemplate">
            <StackPanel>
                <TextBlock Text="Add a searchable command that opens a file, app, folder, or URL."
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6" />
                <TextBox Height="32"
                         Style="{StaticResource ModernTextBox}"
                         Padding="8,0"
                         Tag="Command name"
                         Text="{Binding DataContext.Commands.NewCommandName, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,5" />
                <TextBox Height="32"
                         Style="{StaticResource ModernTextBox}"
                         Padding="8,0"
                         Tag="Target: path, app, folder, or URL"
                         Text="{Binding DataContext.Commands.NewCommandTarget, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,5" />
                <Button Content="Add Command"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding DataContext.Commands.CreateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,7" />
                <ItemsControl ItemsSource="{Binding DataContext.Commands.Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Target}" Style="{StaticResource MutedText}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Run" Command="{Binding RunCommand}" Padding="6,4" Margin="3,0"/>
                                <Button Grid.Column="2" Content="×" Command="{Binding RemoveCommand}" Foreground="{DynamicResource Danger}" Background="Transparent" Padding="5,4"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding DataContext.Commands.StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SearchTemplate">
            <StackPanel>
                <TextBlock Text="Search sources"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,0,0,7"/>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Installed apps"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.SearchAppsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Open windows"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.SearchWindowsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Actions &amp; commands"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.SearchActionsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Macros"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.SearchMacrosEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Settings pages"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.SearchSettingsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Files &amp; folders"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DataContext.SearchFilesEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/></Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="WindowsSettingsTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Make room for the sidebar"/>
                        <TextBlock Text="Resize all visible primary-monitor windows while the sidebar is open."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="250"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding DataContext.ReflowWindowsOnSidebar, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                </Grid>
                <TextBlock Text="Windows return to their previous size and position when the sidebar collapses or exits."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AdvancedTemplate">
            <StackPanel>
                <Button Content="Open Settings Folder"
                        Command="{Binding DataContext.OpenSettingsFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,6"/>
                <TextBlock Text="Settings, favorites, macros, commands, and layout preferences are stored separately from the app files."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HotkeysTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Global shortcuts" />
                        <TextBlock Text="Make your own shortcuts and apply them across Windows."
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding DataContext.GlobalHotkeysEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <TextBlock Text="Type combinations like Ctrl+Space, Ctrl+Shift+F, Alt+F8, Win+Shift+D, or Ctrl+Alt+Left. Click outside a box to apply."
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <TextBlock Text="Toggle sidebar" Style="{StaticResource SecondaryText}" Margin="0,0,0,3"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Height="32"
                         Text="{Binding DataContext.ToggleHotkeyPreset, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                         Margin="0,0,0,6"/>

                <TextBlock Text="Focus Home search" Style="{StaticResource SecondaryText}" Margin="0,0,0,3"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Height="32"
                         Text="{Binding DataContext.SearchHotkeyPreset, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                         Margin="0,0,0,9"/>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Window control shortcuts" />
                        <TextBlock Text="Enable the editable shortcuts below."
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding DataContext.WindowControlHotkeysEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <UniformGrid Columns="2" Margin="0,0,0,5">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Snap left" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Height="30"
                                 Text="{Binding DataContext.SnapLeftHotkey, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="Snap right" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Height="30"
                                 Text="{Binding DataContext.SnapRightHotkey, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="Always on top toggle" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                <TextBox Style="{StaticResource ModernTextBox}" Height="30"
                         Text="{Binding DataContext.ToggleTopmostHotkey, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                         Margin="0,0,0,5"/>

                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Opacity up" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Height="30"
                                 Text="{Binding DataContext.OpacityUpHotkey, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="Opacity down" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Height="30"
                                 Text="{Binding DataContext.OpacityDownHotkey, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                    </StackPanel>
                </UniformGrid>

                <Button Content="Reset hotkeys to defaults"
                        Command="{Binding DataContext.ResetHotkeysCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Padding="8,5"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,6"/>

                <TextBlock Text="A global shortcut must include Ctrl, Alt, Shift, or Win plus one key. Letters, numbers, arrows, Space, Enter, Tab, Esc, Home, End, PageUp/PageDown, Insert/Delete, and F1-F12 are supported. If another app already owns a shortcut, Windows will leave that shortcut unavailable."
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MacrosTemplate">
            <StackPanel>
                <TextBox Height="32"
                         Style="{StaticResource ModernTextBox}"
                         Padding="8,0"
                         Tag="Macro name"
                         Text="{Binding DataContext.Macros.NewMacroName, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,5" />
                <TextBox Height="68"
                         Style="{StaticResource ModernTextBox}"
                         Padding="8"
                         Tag="Commands, one per line"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Hidden"
                         Text="{Binding DataContext.Macros.NewMacroScript, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,5" />
                <Button Content="Create"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding DataContext.Macros.CreateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,7" />
                <ItemsControl ItemsSource="{Binding DataContext.Macros.Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="Run"
                                        Command="{Binding RunCommand}"
                                        Padding="7,4"
                                        Margin="4,0" />
                                <Button Grid.Column="2"
                                        Content="×"
                                        Command="{Binding RemoveCommand}"
                                        Foreground="{DynamicResource Danger}"
                                        Background="Transparent"
                                        Padding="5,4" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding DataContext.Macros.StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource MutedText}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="UpdatesTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Current" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DataContext.Updates.CurrentVersion, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid>
                <TextBlock Text="Release channel"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,0,0,5" />
                <UniformGrid Columns="2" Margin="0,0,0,7">
                    <Button Content="Stable"
                            Command="{Binding DataContext.UpdateStableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="6,5"
                            Margin="0,0,3,0" />
                    <Button Content="Beta"
                            Command="{Binding DataContext.UpdateBetaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="6,5"
                            Margin="3,0,0,0" />
                </UniformGrid>
                <TextBlock Text="{Binding DataContext.UpdateChannel, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Channel: {0}}"
                           Style="{StaticResource MutedText}"
                           Margin="0,0,0,7" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto-check" />
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.AutoCheckForUpdates, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Button Content="Check for Updates"
                        Command="{Binding DataContext.Updates.CheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,5" />
                <Button Content="Update &amp; Restart"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding DataContext.Updates.UpdateAndRestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsEnabled="{Binding DataContext.Updates.IsUpdateAvailable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,5" />
                <Button Content="Roll Back Previous Version"
                        Command="{Binding DataContext.Updates.RollbackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsEnabled="{Binding DataContext.Updates.CanRollback, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,5" />
                <TextBlock Text="{Binding DataContext.Updates.StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AmbienceTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Desktop ambience" />
                        <TextBlock Text="Animation-driven, decorative, and click-through."
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding DataContext.AmbienceEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <TextBlock Text="Layers" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,3,0">
                        <TextBlock Text="Background" FontSize="10" HorizontalAlignment="Center" />
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                  HorizontalAlignment="Center"
                                  IsChecked="{Binding DataContext.AmbienceBackgroundEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="3,0">
                        <TextBlock Text="Creatures" FontSize="10" HorizontalAlignment="Center" />
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                  HorizontalAlignment="Center"
                                  IsChecked="{Binding DataContext.AmbienceCreaturesEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="3,0,0,0">
                        <TextBlock Text="Effects" FontSize="10" HorizontalAlignment="Center" />
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                  HorizontalAlignment="Center"
                                  IsChecked="{Binding DataContext.AmbienceEffectsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="Background scene" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <UniformGrid Columns="2" Margin="0,0,0,4">
                    <Button Content="Coral Reef"
                            Command="{Binding DataContext.AmbienceCoralReefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="6,5"
                            Margin="0,0,3,3" />
                    <Button Content="Deep Ocean"
                            Command="{Binding DataContext.AmbienceDeepOceanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="6,5"
                            Margin="3,0,0,3" />
                    <Button Content="Kelp Forest"
                            Command="{Binding DataContext.AmbienceKelpForestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="6,5"
                            Margin="0,3,3,3" />
                    <Button Content="Fireflies Night"
                            Command="{Binding DataContext.AmbienceFirefliesNightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="6,5"
                            Margin="3,3,0,3" />
                    <Button Content="Minimal"
                            Command="{Binding DataContext.AmbienceMinimalGradientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="6,5"
                            Margin="0,3,3,0" />
                    <Button Content="Space"
                            Command="{Binding DataContext.AmbienceSpaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="6,5"
                            Margin="3,3,0,0" />
                </UniformGrid>
                <TextBlock Text="{Binding DataContext.AmbienceBackgroundPreset, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Background: {0}}"
                           Style="{StaticResource MutedText}"
                           Margin="0,0,0,8" />

                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Background opacity" Style="{StaticResource SecondaryText}" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding DataContext.AmbienceBackgroundOpacity, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:P0}}"
                               Style="{StaticResource MutedText}" />
                </DockPanel>
                <Slider Minimum="0"
                        Maximum="1"
                        TickFrequency="0.05"
                        Style="{StaticResource ModernSlider}"
                        Value="{Binding DataContext.AmbienceBackgroundOpacity, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,6" />

                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Brightness" Style="{StaticResource SecondaryText}" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding DataContext.AmbienceBackgroundBrightness, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0.0}×}"
                               Style="{StaticResource MutedText}" />
                </DockPanel>
                <Slider Minimum="0.4"
                        Maximum="1.6"
                        TickFrequency="0.05"
                        Style="{StaticResource ModernSlider}"
                        Value="{Binding DataContext.AmbienceBackgroundBrightness, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,6" />

                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Background motion" Style="{StaticResource SecondaryText}" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding DataContext.AmbienceBackgroundMotion, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:P0}}"
                               Style="{StaticResource MutedText}" />
                </DockPanel>
                <Slider Minimum="0"
                        Maximum="1"
                        TickFrequency="0.05"
                        Style="{StaticResource ModernSlider}"
                        Value="{Binding DataContext.AmbienceBackgroundMotion, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,8" />

                <TextBlock Text="Creature animation" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <Button Content="Fish"
                            Command="{Binding DataContext.AmbienceAquariumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,5"
                            Margin="0,0,3,0" />
                    <Button Content="Fireflies"
                            Command="{Binding DataContext.AmbienceFirefliesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,5"
                            Margin="3,0" />
                    <Button Content="Pet"
                            Command="{Binding DataContext.AmbiencePetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,5"
                            Margin="3,0,0,0" />
                </UniformGrid>
                <TextBlock Text="{Binding DataContext.AmbienceMode, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Creatures: {0}}"
                           Style="{StaticResource MutedText}"
                           Margin="0,0,0,7" />

                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Creature count" Style="{StaticResource SecondaryText}" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding DataContext.AmbiencePopulation, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource MutedText}" />
                </DockPanel>
                <Slider Minimum="2"
                        Maximum="30"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Style="{StaticResource ModernSlider}"
                        Value="{Binding DataContext.AmbiencePopulation, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,6" />

                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Creature size" Style="{StaticResource SecondaryText}" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding DataContext.AmbienceCreatureSize, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0.0}×}"
                               Style="{StaticResource MutedText}" />
                </DockPanel>
                <Slider Minimum="0.6"
                        Maximum="1.6"
                        TickFrequency="0.05"
                        Style="{StaticResource ModernSlider}"
                        Value="{Binding DataContext.AmbienceCreatureSize, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,6" />

                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Movement speed" Style="{StaticResource SecondaryText}" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding DataContext.AmbienceSpeed, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0.0}×}"
                               Style="{StaticResource MutedText}" />
                </DockPanel>
                <Slider Minimum="0.35"
                        Maximum="2.5"
                        TickFrequency="0.05"
                        Style="{StaticResource ModernSlider}"
                        Value="{Binding DataContext.AmbienceSpeed, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,6" />

                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Creature opacity" Style="{StaticResource SecondaryText}" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding DataContext.AmbienceOpacity, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:P0}}"
                               Style="{StaticResource MutedText}" />
                </DockPanel>
                <Slider Minimum="0.15"
                        Maximum="1"
                        TickFrequency="0.05"
                        Style="{StaticResource ModernSlider}"
                        Value="{Binding DataContext.AmbienceOpacity, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,7" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Random directions" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.AmbienceRandomDirection, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Schooling" />
                        <TextBlock Text="Fish share loose depth bands for a calmer look."
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding DataContext.AmbienceSchooling, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <TextBlock Text="Foreground effects" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Bubbles" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding DataContext.AmbienceBubbleIntensity, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:P0}}"
                               Style="{StaticResource MutedText}" />
                </DockPanel>
                <Slider Minimum="0"
                        Maximum="1"
                        TickFrequency="0.05"
                        Style="{StaticResource ModernSlider}"
                        Value="{Binding DataContext.AmbienceBubbleIntensity, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,5" />

                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Particles" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding DataContext.AmbienceParticleIntensity, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:P0}}"
                               Style="{StaticResource MutedText}" />
                </DockPanel>
                <Slider Minimum="0"
                        Maximum="1"
                        TickFrequency="0.05"
                        Style="{StaticResource ModernSlider}"
                        Value="{Binding DataContext.AmbienceParticleIntensity, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,5" />

                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Glow" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding DataContext.AmbienceGlowIntensity, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:P0}}"
                               Style="{StaticResource MutedText}" />
                </DockPanel>
                <Slider Minimum="0"
                        Maximum="1"
                        TickFrequency="0.05"
                        Style="{StaticResource ModernSlider}"
                        Value="{Binding DataContext.AmbienceGlowIntensity, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,7" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Performance mode" />
                        <TextBlock Text="Caps creature/effect counts and disables expensive shadows."
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding DataContext.AmbiencePerformanceMode, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Use all monitors" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.AmbienceAllMonitors, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Show over apps" />
                        <TextBlock Text="Off keeps the animated scene behind normal windows."
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding DataContext.AmbienceOverApps, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <TextBlock Text="Fish movement now uses WPF animation clocks instead of a per-frame simulation loop. Breeding simulation has been removed to keep ambience smooth and predictable."
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AppearanceTemplate">
            <StackPanel>
                <TextBlock Text="Theme"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,0,0,5" />
                <UniformGrid Columns="3" Margin="0,0,0,9">
                    <Button Content="Dark"
                            Command="{Binding DataContext.ThemeDarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,5"
                            Margin="0,0,3,0" />
                    <Button Content="Light"
                            Command="{Binding DataContext.ThemeLightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,5"
                            Margin="3,0" />
                    <Button Content="System"
                            Command="{Binding DataContext.ThemeSystemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,5"
                            Margin="3,0,0,0" />
                </UniformGrid>
                <TextBlock Text="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Current theme: {0}}"
                           Style="{StaticResource MutedText}"
                           Margin="0,0,0,8" />

                <TextBlock Text="Accent color"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,0,0,6" />
                <UniformGrid Columns="4">
                    <Button Content="Blue"
                            Command="{Binding DataContext.AccentBlueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,5"
                            Margin="0,0,3,0" />
                    <Button Content="Purple"
                            Command="{Binding DataContext.AccentPurpleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,5"
                            Margin="3,0" />
                    <Button Content="Green"
                            Command="{Binding DataContext.AccentGreenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,5"
                            Margin="3,0" />
                    <Button Content="Orange"
                            Command="{Binding DataContext.AccentOrangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,5"
                            Margin="3,0,0,0" />
                </UniformGrid>
                <TextBlock Text="{Binding DataContext.AccentName, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Current accent: {0}}"
                           Style="{StaticResource MutedText}"
                           Margin="0,7,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GenericTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Description}"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap" />
                <TextBlock Text="Desktop Command Center will show real system information here as supported controls are added. It will not create switches that only look like they change Windows."
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,12" />
                <Button Content="Open Windows Settings"
                        Command="{Binding DataContext.OpenWindowsSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Settings"
                       Style="{StaticResource PageTitleText}"
                       FontSize="22"
                       Margin="4,0,0,12" />

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="⌕" FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBox Style="{StaticResource ModernTextBox}"
                         Height="38"
                         Tag="Find a setting"
                         Text="{Binding SettingsSearchText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <ListBox Grid.Row="2"
                 ItemsSource="{Binding FilteredCategories}"
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource SettingsCategoryItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 Margin="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="3"
                    Style="{StaticResource CardStyle}"
                    Padding="10"
                    Margin="0,10,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,7">
                        <TextBlock Text="App updates"
                                   FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Updates.CurrentVersion, StringFormat=v{0}}"
                                   Style="{StaticResource MutedText}" />
                    </DockPanel>
                    <Button Content="Check for updates"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding Updates.CheckCommand}"
                            HorizontalContentAlignment="Center" />
                    <TextBlock Text="{Binding Updates.StatusMessage}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <Border Style="{StaticResource CardStyle}"
                    Padding="22"
                    Margin="0,2,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="{Binding SelectedCategory.Name}"
                                   Style="{StaticResource PageTitleText}"
                                   FontSize="22" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding SelectedCategory.Description}"
                                   Style="{StaticResource MutedText}"
                                   MaxWidth="360"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap" />
                    </DockPanel>

                    <ContentControl Content="{Binding SelectedCategory}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource GenericTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="General">
                                        <Setter Property="ContentTemplate" Value="{StaticResource GeneralTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Customize Home">
                                        <Setter Property="ContentTemplate" Value="{StaticResource CustomizeHomeTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Favorites">
                                        <Setter Property="ContentTemplate" Value="{StaticResource FavoritesTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Quick Actions">
                                        <Setter Property="ContentTemplate" Value="{StaticResource QuickActionsTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Commands">
                                        <Setter Property="ContentTemplate" Value="{StaticResource CommandsTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Search">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SearchTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Window management">
                                        <Setter Property="ContentTemplate" Value="{StaticResource WindowsSettingsTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Advanced">
                                        <Setter Property="ContentTemplate" Value="{StaticResource AdvancedTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Hotkeys">
                                        <Setter Property="ContentTemplate" Value="{StaticResource HotkeysTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Macros">
                                        <Setter Property="ContentTemplate" Value="{StaticResource MacrosTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Ambience">
                                        <Setter Property="ContentTemplate" Value="{StaticResource AmbienceTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Appearance">
                                        <Setter Property="ContentTemplate" Value="{StaticResource AppearanceTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Updates">
                                        <Setter Property="ContentTemplate" Value="{StaticResource UpdatesTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
