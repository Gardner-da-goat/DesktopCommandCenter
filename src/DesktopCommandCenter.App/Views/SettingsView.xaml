<UserControl x:Class="DesktopCommandCenter.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="StartStateOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Padding="10,7" Background="{DynamicResource CardHoverBackground}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GeneralTemplate">
            <StackPanel>
                <TextBlock Text="Start State" Style="{StaticResource SecondaryText}" Margin="0,0,0,7" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <RadioButton Content="Collapsed" GroupName="StartState"
                                 Style="{StaticResource StartStateOption}"
                                 IsChecked="{Binding DataContext.StartCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                    <RadioButton Grid.Column="2" Content="Expanded" GroupName="StartState"
                                 Style="{StaticResource StartStateOption}"
                                 IsChecked="{Binding DataContext.StartCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}" />
                </Grid>

                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="Sidebar Width" Style="{StaticResource SecondaryText}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}">
                        <Run Text="{Binding DataContext.SidebarWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay, StringFormat={}{0:0}}" />
                        <Run Text=" DIP" />
                    </TextBlock>
                </DockPanel>
                <Slider Minimum="300" Maximum="520" TickFrequency="1"
                        Style="{StaticResource ModernSlider}"
                        Value="{Binding DataContext.SidebarWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Grid Margin="0,1,0,16">
                    <TextBlock Text="300" Style="{StaticResource MutedText}" />
                    <TextBlock Text="520" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Always on Top" />
                        <TextBlock Text="Keep the sidebar above normal windows." Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                              IsChecked="{Binding DataContext.AlwaysOnTop, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Animations" />
                        <TextBlock Text="Animate sidebar expansion and collapse." Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                              IsChecked="{Binding DataContext.AnimationsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Show Tray Icon" />
                        <TextBlock Text="Keep quick controls in the notification area." Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                              IsChecked="{Binding DataContext.ShowTrayIcon, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CustomizeHomeTemplate">
            <StackPanel>
                <TextBlock Text="Home Modules" Style="{StaticResource SecondaryText}" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="≡" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Column="1" Text="Search Bar"/>
                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowSearchModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="≡" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Column="1" Text="Favorites"/>
                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowFavoritesModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="≡" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Column="1" Text="Current Window"/>
                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowCurrentWindowModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="≡" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Column="1" Text="Quick Actions"/>
                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowQuickActionsModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="≡" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Column="1" Text="Macros"/>
                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowMacrosModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                </Grid>

                <TextBlock Text="Visibility changes save immediately. Drag reordering is planned for a later update."
                           Style="{StaticResource MutedText}" Margin="0,13,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FavoritesTemplate">
            <StackPanel>
                <TextBlock Text="Pinned Apps" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" />
                <TextBlock Text="Pin apps from the Home search results. Favorites save automatically."
                           Style="{StaticResource MutedText}" Margin="0,0,0,12" />

                <ItemsControl ItemsSource="{Binding DataContext.Favorites.Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding LaunchPath}"
                                               Style="{StaticResource MutedText}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="180" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Remove"
                                        Command="{Binding RemoveCommand}"
                                        Foreground="{DynamicResource Danger}"
                                        Background="Transparent"
                                        Padding="8,5" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No favorites yet. Search for an app on Home and choose Pin."
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.Favorites.HasFavorites, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HotkeysTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Toggle Sidebar"/><TextBlock Text="Ctrl + Space" Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Edit" IsEnabled="False"/></Grid>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Focus Search"/><TextBlock Text="Ctrl + Shift + Space" Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Edit" IsEnabled="False"/></Grid>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Opacity Up"/><TextBlock Text="Unassigned" Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Edit" IsEnabled="False"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Always On Top"/><TextBlock Text="Unassigned" Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Edit" IsEnabled="False"/></Grid>
                <TextBlock Text="Global hotkeys are not connected yet." Style="{StaticResource MutedText}" Margin="0,13,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MacrosTemplate">
            <StackPanel>
                <TextBlock Text="Create Macro" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" />

                <TextBox Height="38"
                         Style="{StaticResource ModernTextBox}"
                         Padding="10,0"
                         Tag="Macro name"
                         Text="{Binding DataContext.Macros.NewMacroName, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8" />

                <TextBox Height="110"
                         Style="{StaticResource ModernTextBox}"
                         Padding="10"
                         Tag="Commands, one per line"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding DataContext.Macros.NewMacroScript, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8" />

                <TextBlock Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10">
                    <Run Text="Allowed: favorite NAME, delay MS, downloads, taskmanager, settings, terminal, snap-left, snap-right, center, minimize, maximize, opacity 20-100, top on/off." />
                </TextBlock>

                <Button Content="Create Macro"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding DataContext.Macros.CreateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,14" />

                <TextBlock Text="Saved Macros" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" />

                <ItemsControl ItemsSource="{Binding DataContext.Macros.Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,7"
                                    Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Script}"
                                               Style="{StaticResource MutedText}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="36"
                                               Margin="0,3,0,7" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Run" Command="{Binding RunCommand}" />
                                        <Button Grid.Column="2"
                                                Content="Remove"
                                                Command="{Binding RemoveCommand}"
                                                Foreground="{DynamicResource Danger}"
                                                Background="Transparent" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No macros yet."
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.Macros.HasMacros, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding DataContext.Macros.StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource MutedText}"
                           Margin="0,10,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AppearanceTemplate">
            <StackPanel>
                <TextBlock Text="Theme" Style="{StaticResource SecondaryText}" Margin="0,0,0,7" />
                <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Dark" Style="{StaticResource AccentButton}"/><Button Grid.Column="2" Content="Light" IsEnabled="False"/><Button Grid.Column="4" Content="System" IsEnabled="False"/></Grid>
                <TextBlock Text="Accent Color" Style="{StaticResource SecondaryText}" />
                <Border Width="26" Height="26" HorizontalAlignment="Left" Margin="0,7,0,14" CornerRadius="8" Background="{DynamicResource Accent}" />
                <TextBlock Text="Sidebar Transparency" Style="{StaticResource SecondaryText}" />
                <Slider Style="{StaticResource ModernSlider}" Value="90" IsEnabled="False" Margin="0,4,0,10" />
                <TextBlock Text="Corner Radius" Style="{StaticResource SecondaryText}" />
                <Slider Style="{StaticResource ModernSlider}" Value="18" Maximum="30" IsEnabled="False" Margin="0,4,0,10" />
                <TextBlock Text="Animation Speed" Style="{StaticResource SecondaryText}" />
                <Slider Style="{StaticResource ModernSlider}" Value="50" IsEnabled="False" Margin="0,4,0,0" />
                <TextBlock Text="Additional themes and appearance controls are not connected yet." Style="{StaticResource MutedText}" Margin="0,12,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="UpdatesTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Current Version" Style="{StaticResource SecondaryText}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DataContext.Updates.CurrentVersion, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Latest Release" Style="{StaticResource SecondaryText}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DataContext.Updates.LatestVersion, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Automatically Check for Updates"/>
                        <TextBlock Text="Check GitHub Releases when the app starts." Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.AutoCheckForUpdates, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                </Grid>

                <Button Content="Check for Updates"
                        Command="{Binding DataContext.Updates.CheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,8"/>

                <Button Content="Update &amp; Restart"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding DataContext.Updates.UpdateAndRestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsEnabled="{Binding DataContext.Updates.IsUpdateAvailable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,10"/>

                <TextBlock Text="{Binding DataContext.Updates.StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"/>

                <ProgressBar Height="4"
                             Minimum="0"
                             Maximum="1"
                             Value="{Binding DataContext.Updates.DownloadProgress, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Margin="0,10,0,0"
                             Visibility="{Binding DataContext.Updates.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AdvancedTemplate">
            <StackPanel>
                <Button Content="Open settings folder" Margin="0,0,0,8" IsEnabled="False" />
                <Button Content="Reset settings" Margin="0,0,0,8" IsEnabled="False" />
                <Grid Margin="0,8,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Developer mode"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsEnabled="False"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Diagnostic logging"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsEnabled="False"/></Grid>
                <TextBlock Text="Advanced maintenance tools are intentionally unavailable in Phase 1." Style="{StaticResource MutedText}" Margin="0,13,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GenericTemplate">
            <StackPanel>
                <Border Width="42" Height="42" HorizontalAlignment="Left" CornerRadius="12" Background="{DynamicResource AccentSoft}" Margin="0,0,0,12">
                    <TextBlock Text="◇" FontSize="20" Foreground="{DynamicResource AccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="This section is a polished placeholder. Its controls will be connected in a later phase." Style="{StaticResource MutedText}" Margin="0,9,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="14,14,14,24">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleText}" Margin="2,0,0,5" />
            <TextBlock Text="Make the command center work your way." Style="{StaticResource MutedText}" Margin="2,0,0,14" />

            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     ItemContainerStyle="{StaticResource SettingsCategoryItem}"
                     Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,16"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedCategory.Name}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SelectedCategory.Description}" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                    <ContentControl Content="{Binding SelectedCategory}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource GenericTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="General"><Setter Property="ContentTemplate" Value="{StaticResource GeneralTemplate}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Favorites"><Setter Property="ContentTemplate" Value="{StaticResource FavoritesTemplate}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Customize Home"><Setter Property="ContentTemplate" Value="{StaticResource CustomizeHomeTemplate}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Hotkeys"><Setter Property="ContentTemplate" Value="{StaticResource HotkeysTemplate}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Macros"><Setter Property="ContentTemplate" Value="{StaticResource MacrosTemplate}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Appearance"><Setter Property="ContentTemplate" Value="{StaticResource AppearanceTemplate}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Updates"><Setter Property="ContentTemplate" Value="{StaticResource UpdatesTemplate}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Advanced"><Setter Property="ContentTemplate" Value="{StaticResource AdvancedTemplate}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>