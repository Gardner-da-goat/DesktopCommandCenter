<UserControl x:Class="DesktopCommandCenter.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CompactCategoryItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactStartOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome"
                                Padding="8,5"
                                Background="{DynamicResource CardHoverBackground}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GeneralTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <RadioButton Content="Collapsed"
                                 GroupName="StartState"
                                 Style="{StaticResource CompactStartOption}"
                                 IsChecked="{Binding DataContext.StartCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                    <RadioButton Grid.Column="2"
                                 Content="Expanded"
                                 GroupName="StartState"
                                 Style="{StaticResource CompactStartOption}"
                                 IsChecked="{Binding DataContext.StartCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}" />
                </Grid>

                <TextBlock Text="Screen side"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,0,0,4" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <RadioButton Content="Left"
                                 GroupName="SidebarSide"
                                 Style="{StaticResource CompactStartOption}"
                                 IsChecked="{Binding DataContext.IsSidebarOnLeft, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                    <RadioButton Grid.Column="2"
                                 Content="Right"
                                 GroupName="SidebarSide"
                                 Style="{StaticResource CompactStartOption}"
                                 IsChecked="{Binding DataContext.IsSidebarOnRight, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sidebar width"
                               Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="−20"
                            Command="{Binding DataContext.DecreaseSidebarWidthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="7,3"
                            Margin="4,0,4,0" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding DataContext.SidebarWidth, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0}}"
                               VerticalAlignment="Center"
                               MinWidth="30"
                               TextAlignment="Center" />
                    <Button Grid.Column="3"
                            Content="+20"
                            Command="{Binding DataContext.IncreaseSidebarWidthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="7,3"
                            Margin="4,0,0,0" />
                </Grid>
                <Slider Minimum="300"
                        Maximum="520"
                        TickFrequency="10"
                        SmallChange="10"
                        LargeChange="20"
                        Style="{StaticResource ModernSlider}"
                        Value="{Binding DataContext.SidebarWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,5" />
                <UniformGrid Columns="4" Margin="0,0,0,8">
                    <Button Content="320"
                            Command="{Binding DataContext.Width320Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,4"
                            Margin="0,0,3,0" />
                    <Button Content="360"
                            Command="{Binding DataContext.Width360Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,4"
                            Margin="3,0" />
                    <Button Content="420"
                            Command="{Binding DataContext.Width420Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,4"
                            Margin="3,0" />
                    <Button Content="480"
                            Command="{Binding DataContext.Width480Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="5,4"
                            Margin="3,0,0,0" />
                </UniformGrid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Always on top" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.AlwaysOnTop, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Animations" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.AnimationsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Tray icon" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowTrayIcon, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CustomizeHomeTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Search" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowSearchModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Favorites" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowFavoritesModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Current Window" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowCurrentWindowModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Quick Actions" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowQuickActionsModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Macros" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.ShowMacrosModule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FavoritesTemplate">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding DataContext.Favorites.Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="Remove"
                                        Command="{Binding RemoveCommand}"
                                        Padding="7,4"
                                        Foreground="{DynamicResource Danger}"
                                        Background="Transparent" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Pin apps from Home search results."
                           Style="{StaticResource MutedText}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HotkeysTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Global shortcuts" />
                        <TextBlock Text="Ctrl+Space · Ctrl+Shift+Space"
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.GlobalHotkeysEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <TextBlock Text="Toggle sidebar or jump straight to Search."
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MacrosTemplate">
            <StackPanel>
                <TextBox Height="32"
                         Style="{StaticResource ModernTextBox}"
                         Padding="8,0"
                         Tag="Macro name"
                         Text="{Binding DataContext.Macros.NewMacroName, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,5" />
                <TextBox Height="68"
                         Style="{StaticResource ModernTextBox}"
                         Padding="8"
                         Tag="Commands, one per line"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Hidden"
                         Text="{Binding DataContext.Macros.NewMacroScript, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,5" />
                <Button Content="Create"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding DataContext.Macros.CreateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,7" />
                <ItemsControl ItemsSource="{Binding DataContext.Macros.Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="Run"
                                        Command="{Binding RunCommand}"
                                        Padding="7,4"
                                        Margin="4,0" />
                                <Button Grid.Column="2"
                                        Content="×"
                                        Command="{Binding RemoveCommand}"
                                        Foreground="{DynamicResource Danger}"
                                        Background="Transparent"
                                        Padding="5,4" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding DataContext.Macros.StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource MutedText}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="UpdatesTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Current" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DataContext.Updates.CurrentVersion, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto-check" />
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding DataContext.AutoCheckForUpdates, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Grid>
                <Button Content="Check for Updates"
                        Command="{Binding DataContext.Updates.CheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,5" />
                <Button Content="Update &amp; Restart"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding DataContext.Updates.UpdateAndRestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsEnabled="{Binding DataContext.Updates.IsUpdateAvailable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,5" />
                <TextBlock Text="{Binding DataContext.Updates.StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AppearanceTemplate">
            <StackPanel>
                <TextBlock Text="Dark theme is active."
                           Style="{StaticResource SecondaryText}" />
                <TextBlock Text="More themes and transparency controls are planned."
                           Style="{StaticResource MutedText}"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GenericTemplate">
            <TextBlock Text="{Binding Description}"
                       Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings"
                   Style="{StaticResource PageTitleText}"
                   Margin="2,0,0,7" />

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource CompactCategoryItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 Margin="0,0,-6,2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"
                               FontSize="10.5"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <Border Style="{StaticResource CardStyle}"
                    Padding="9"
                    Margin="0,2,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding SelectedCategory.Name}"
                                   Style="{StaticResource SectionTitleText}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding SelectedCategory.Description}"
                                   Style="{StaticResource MutedText}"
                                   MaxWidth="150"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ContentControl Content="{Binding SelectedCategory}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource GenericTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="General">
                                        <Setter Property="ContentTemplate" Value="{StaticResource GeneralTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Customize Home">
                                        <Setter Property="ContentTemplate" Value="{StaticResource CustomizeHomeTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Favorites">
                                        <Setter Property="ContentTemplate" Value="{StaticResource FavoritesTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Hotkeys">
                                        <Setter Property="ContentTemplate" Value="{StaticResource HotkeysTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Macros">
                                        <Setter Property="ContentTemplate" Value="{StaticResource MacrosTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Appearance">
                                        <Setter Property="ContentTemplate" Value="{StaticResource AppearanceTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory.Name}" Value="Updates">
                                        <Setter Property="ContentTemplate" Value="{StaticResource UpdatesTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
