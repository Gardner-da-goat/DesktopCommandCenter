<Window x:Class="DesktopCommandCenter.App.Views.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Command Center"
        Width="34" Height="720"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" AllowsTransparency="True"
        Background="Transparent" Topmost="{Binding AlwaysOnTop}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Background="Transparent">
        <Border x:Name="ExpandedPanel"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1,1,0,1"
                CornerRadius="18,0,0,18">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="-4" Direction="0"
                                  Color="#90000000" Opacity="0.55" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Accent}">
                        <TextBlock Text="⌘" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Desktop Command Center"
                               Style="{StaticResource AppTitleText}"
                               Margin="10,0,6,0" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                            Command="{Binding CollapseCommand}" ToolTip="Collapse">
                        <TextBlock Text="❯" FontSize="15" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource NavigationBackground}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,1,0">
                        <StackPanel Margin="0,8,0,0">
                            <RadioButton GroupName="MainNavigation"
                                         Style="{StaticResource NavigationButton}"
                                         IsChecked="{Binding IsHomeSelected, Mode=OneWay}"
                                         Command="{Binding ShowHomeCommand}" ToolTip="Home">
                                <TextBlock Text="⌂" FontFamily="Segoe UI Symbol" FontSize="20" />
                            </RadioButton>

                            <RadioButton GroupName="MainNavigation"
                                         Style="{StaticResource NavigationButton}"
                                         IsChecked="{Binding IsWindowsSelected, Mode=OneWay}"
                                         Command="{Binding ShowWindowsCommand}" ToolTip="Windows">
                                <TextBlock Text="▣" FontFamily="Segoe UI Symbol" FontSize="18" />
                            </RadioButton>

                            <RadioButton GroupName="MainNavigation"
                                         Style="{StaticResource NavigationButton}"
                                         IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                                         Command="{Binding ShowSettingsCommand}" ToolTip="Settings">
                                <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="18" />
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
                </Grid>
            </Grid>
        </Border>

        <Button x:Name="CollapsedHandle" Width="34" Height="112"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Padding="0" Background="{DynamicResource PanelBackground}"
                Command="{Binding ExpandCommand}"
                ToolTip="Open Desktop Command Center">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="HandleChrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1,1,0,1"
                                        CornerRadius="12,0,0,12">
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="7"
                                                Background="{DynamicResource Accent}" Margin="0,0,0,10">
                                            <TextBlock Text="⌘" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="❮" FontSize="14" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HandleChrome" Property="Background" Value="{DynamicResource CardHoverBackground}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="HandleChrome" Property="Opacity" Value="0.76" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
