<Window x:Class="DesktopCommandCenter.App.Views.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Command Center"
        Width="34" Height="720"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" AllowsTransparency="True"
        Background="Transparent" Topmost="{Binding AlwaysOnTop}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Background="Transparent">
        <Border x:Name="ExpandedPanel"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderSubtle}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="BorderThickness" Value="1,1,0,1" />
                    <Setter Property="CornerRadius" Value="14,0,0,14" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarOnLeft}" Value="True">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSidebarOnLeft}" Value="True">
                            <Setter Property="BorderThickness" Value="0,1,1,1" />
                            <Setter Property="CornerRadius" Value="0,14,14,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="24"
                            Height="24"
                            CornerRadius="7"
                            Background="{DynamicResource Accent}">
                        <TextBlock Text="⌘"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="Desktop Command Center"
                               Style="{StaticResource AppTitleText}"
                               FontSize="15"
                               Margin="8,0,4,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <Button Grid.Column="2"
                            Width="30"
                            Height="30"
                            Style="{StaticResource IconButton}"
                            Command="{Binding CollapseCommand}"
                            ToolTip="Collapse">
                        <TextBlock Text="{Binding CollapseArrowGlyph}" FontSize="13" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource NavigationBackground}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,1,0">
                        <StackPanel Margin="0,6,0,0">
                            <RadioButton GroupName="MainNavigation"
                                         Width="36" Height="36" Margin="6,3"
                                         Style="{StaticResource NavigationButton}"
                                         IsChecked="{Binding IsHomeSelected, Mode=OneWay}"
                                         Command="{Binding ShowHomeCommand}"
                                         ToolTip="Home">
                                <TextBlock Text="⌂" FontFamily="Segoe UI Symbol" FontSize="17" />
                            </RadioButton>

                            <RadioButton GroupName="MainNavigation"
                                         Width="36" Height="36" Margin="6,3"
                                         Style="{StaticResource NavigationButton}"
                                         IsChecked="{Binding IsWindowsSelected, Mode=OneWay}"
                                         Command="{Binding ShowWindowsCommand}"
                                         ToolTip="Windows">
                                <TextBlock Text="▣" FontFamily="Segoe UI Symbol" FontSize="15" />
                            </RadioButton>

                            <RadioButton GroupName="MainNavigation"
                                         Width="36" Height="36" Margin="6,3"
                                         Style="{StaticResource NavigationButton}"
                                         IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                                         Command="{Binding ShowSettingsCommand}"
                                         ToolTip="Settings">
                                <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="15" />
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <ContentControl Grid.Column="1"
                                    Content="{Binding CurrentPage}"
                                    ClipToBounds="True" />
                </Grid>
            </Grid>
        </Border>

        <Button x:Name="CollapsedHandle"
                Width="34"
                Height="98"
                VerticalAlignment="Center"
                Padding="0"
                Background="{DynamicResource PanelBackground}"
                Command="{Binding ExpandCommand}"
                ToolTip="Open Desktop Command Center"
                MouseEnter="OnCollapsedHandleMouseEnter">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="HandleChrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1,1,0,1"
                                        CornerRadius="11,0,0,11">
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Width="20"
                                                Height="20"
                                                CornerRadius="6"
                                                Background="{DynamicResource Accent}"
                                                Margin="0,0,0,8">
                                            <TextBlock Text="⌘"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding HandleArrowGlyph}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarOnLeft}" Value="True">
                                        <Setter TargetName="HandleChrome" Property="BorderThickness" Value="0,1,1,1" />
                                        <Setter TargetName="HandleChrome" Property="CornerRadius" Value="0,11,11,0" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HandleChrome"
                                                Property="Background"
                                                Value="{DynamicResource CardHoverBackground}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
