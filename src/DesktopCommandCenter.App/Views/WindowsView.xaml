<UserControl x:Class="DesktopCommandCenter.App.Views.WindowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="14,14,14,24">
            <Grid Margin="2,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Windows" Style="{StaticResource PageTitleText}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0">
                        <Run Text="{Binding WindowCount}" />
                        <Run Text=" open windows" />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"
                        Padding="10,6" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Window controls" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Focus, resize, pin, move, and adjust opacity without leaving the command center."
                               Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Windows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ProcessName}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Width="7" Height="7"
                                            CornerRadius="4"
                                            Background="{DynamicResource Accent}"
                                            VerticalAlignment="Top"
                                            Margin="8,5,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>

                                <Button Content="Focus"
                                        Command="{Binding ActivateCommand}"
                                        Style="{StaticResource AccentButton}"
                                        Margin="0,12,0,12" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Opacity" Style="{StaticResource SecondaryText}" />
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}">
                                        <Run Text="{Binding Opacity}" />
                                        <Run Text="%" />
                                    </TextBlock>
                                </DockPanel>
                                <Slider Minimum="20" Maximum="100"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="False"
                                        Style="{StaticResource ModernSlider}"
                                        Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Margin="0,8,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Always on top" />
                                        <TextBlock Text="Keep this window above normal windows."
                                                   Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Minimize" Command="{Binding MinimizeCommand}" Padding="5,7" />
                                    <Button Grid.Column="2" Content="Maximize" Command="{Binding MaximizeCommand}" Padding="5,7" />
                                    <Button Grid.Column="4" Content="Restore" Command="{Binding RestoreCommand}" Padding="5,7" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Snap Left" Command="{Binding SnapLeftCommand}" />
                                    <Button Grid.Column="2" Content="Snap Right" Command="{Binding SnapRightCommand}" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Center" Command="{Binding CenterCommand}" />
                                    <Button Grid.Column="2"
                                            Content="Next Monitor"
                                            Command="{Binding MoveToNextMonitorCommand}"
                                            ToolTip="Move this window to the next monitor and center it." />
                                </Grid>

                                <Button Content="Close Window"
                                        Command="{Binding CloseCommand}"
                                        Foreground="{DynamicResource Danger}"
                                        Background="Transparent"
                                        HorizontalAlignment="Left"
                                        Padding="0,5"
                                        ToolTip="Ask the application to close this window. Unsaved work may prompt inside that app." />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="No normal application windows are currently available."
                       HorizontalAlignment="Center"
                       Margin="0,20">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowCount}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
