<UserControl x:Class="DesktopCommandCenter.App.Views.WindowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="10,10,10,18">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Windows" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource MutedText}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Padding="8,5"
                        VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Choose a window"
                               Style="{StaticResource SecondaryText}"
                               Margin="2,0,0,5" />
                    <ListBox ItemsSource="{Binding Windows}"
                             SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                             MaxHeight="120"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ItemContainerStyle="{StaticResource SettingsCategoryItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ProcessName}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="10"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="●"
                                               Foreground="{DynamicResource Accent}"
                                               FontSize="8"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}"
                    Padding="8"
                    Visibility="{Binding HasSelectedWindow, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedWindow.Title}"
                               Style="{StaticResource SectionTitleText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SelectedWindow.ProcessName}"
                               Style="{StaticResource MutedText}"
                               Margin="0,1,0,6" />

                    <Button Content="Focus"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding SelectedWindow.ActivateCommand}"
                            Margin="0,0,0,6" />

                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="Opacity" Style="{StaticResource SecondaryText}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}">
                            <Run Text="{Binding SelectedWindow.Opacity}" />
                            <Run Text="%" />
                        </TextBlock>
                    </DockPanel>

                    <Slider Minimum="20"
                            Maximum="100"
                            TickFrequency="1"
                            Style="{StaticResource ModernSlider}"
                            Value="{Binding SelectedWindow.Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,6" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Always on top"
                                   VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding SelectedWindow.IsAlwaysOnTop, Mode=TwoWay}" />
                    </Grid>

                    <UniformGrid Columns="3" Margin="0,0,0,6">
                        <Button Content="Min"
                                Command="{Binding SelectedWindow.MinimizeCommand}"
                                Padding="5,6"
                                Margin="0,0,3,0" />
                        <Button Content="Max"
                                Command="{Binding SelectedWindow.MaximizeCommand}"
                                Padding="5,6"
                                Margin="3,0" />
                        <Button Content="Restore"
                                Command="{Binding SelectedWindow.RestoreCommand}"
                                Padding="5,6"
                                Margin="3,0,0,0" />
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button Content="Snap Left"
                                Command="{Binding SelectedWindow.SnapLeftCommand}"
                                Padding="5,6"
                                Margin="0,0,3,0" />
                        <Button Content="Snap Right"
                                Command="{Binding SelectedWindow.SnapRightCommand}"
                                Padding="5,6"
                                Margin="3,0,0,0" />
                    </UniformGrid>

                    <TextBlock Text="Layouts"
                               Style="{StaticResource MutedText}"
                               Margin="0,1,0,4" />
                    <UniformGrid Columns="3" Margin="0,0,0,5">
                        <Button Content="⅓ Left" Command="{Binding SelectedWindow.LeftThirdCommand}" Padding="4,5" Margin="0,0,3,0"/>
                        <Button Content="⅓ Center" Command="{Binding SelectedWindow.CenterThirdCommand}" Padding="4,5" Margin="3,0"/>
                        <Button Content="⅓ Right" Command="{Binding SelectedWindow.RightThirdCommand}" Padding="4,5" Margin="3,0,0,0"/>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,5">
                        <Button Content="⅔ Left" Command="{Binding SelectedWindow.LeftTwoThirdsCommand}" Padding="4,5" Margin="0,0,3,0"/>
                        <Button Content="⅔ Right" Command="{Binding SelectedWindow.RightTwoThirdsCommand}" Padding="4,5" Margin="3,0,0,0"/>
                    </UniformGrid>
                    <UniformGrid Columns="4" Margin="0,0,0,6">
                        <Button Content="TL" ToolTip="Top left quarter" Command="{Binding SelectedWindow.TopLeftQuarterCommand}" Padding="4,5" Margin="0,0,2,0"/>
                        <Button Content="TR" ToolTip="Top right quarter" Command="{Binding SelectedWindow.TopRightQuarterCommand}" Padding="4,5" Margin="2,0"/>
                        <Button Content="BL" ToolTip="Bottom left quarter" Command="{Binding SelectedWindow.BottomLeftQuarterCommand}" Padding="4,5" Margin="2,0"/>
                        <Button Content="BR" ToolTip="Bottom right quarter" Command="{Binding SelectedWindow.BottomRightQuarterCommand}" Padding="4,5" Margin="2,0,0,0"/>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button Content="Center"
                                Command="{Binding SelectedWindow.CenterCommand}"
                                Padding="5,6"
                                Margin="0,0,3,0" />
                        <Button Content="Next Monitor"
                                Command="{Binding SelectedWindow.MoveToNextMonitorCommand}"
                                Padding="5,6"
                                Margin="3,0,0,0" />
                    </UniformGrid>

                    <Button Content="Close Window"
                            Command="{Binding SelectedWindow.CloseCommand}"
                            Foreground="{DynamicResource Danger}"
                            Background="Transparent"
                            HorizontalAlignment="Left"
                            Padding="0,4" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
